{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "theme": "vague",
  "update": "auto",
  "plugins": ["{env:HOME}/.files/components/opencode/plugins/force-background"],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "/var/home/pm/.local/share/mise/shims/bun",
          "x",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--headless"
        ],
        "environment": {
          "MISE_GLOBAL_CONFIG_FILE": "/var/home/pm/.files/mise.toml"
        }
      }
    }
  }
}
