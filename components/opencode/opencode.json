{
  "$schema": "https://opencode.ai/config.json",
  "theme": "vague",
  "autoupdate": false,
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@playwright/mcp",
          "--browser",
          "chromium",
          "--headless"
        ]
      },
      "svelte": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@sveltejs/mcp"
        ]
      }
    }
  }
}
