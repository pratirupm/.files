{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "theme": "vague",
  "update": "auto",
  "plugins": ["{env:HOME}/.files/components/opencode/plugins/force-background"],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bun",
          "x",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--headless"
        ]
      },
      "svelte": {
        "type": "local",
        "command": [
          "bun",
          "x",
          "-y",
          "@sveltejs/mcp"
        ]
      }
    }
  }
}
